#!/usr/bin/env bash

set -o nounset
set -o errexit
set -o pipefail

TAG="localhost/kubernetes/pause:latest"
EXPORT_PATH="/etc/eks/pause.tar"

while getopts 'i:t:e:' OPTION; do
  case "$OPTION" in
    i) PAUSE_CONTAINER_IMAGE="$OPTARG" ;;
    t) TAG="$OPTARG" ;;
    e) EXPORT_PATH="$OPTARG" ;;
    *)
      echo "usage: $0 [-i] [-t] [-e]" >&2
      exit 1
      ;;
  esac
done

# pull the sandbox using aws credentials and tag it under a different name
PULL_ARGS=""
if [[ "${PAUSE_CONTAINER_IMAGE}" == *"dkr.ecr"* ]]; then
  PULL_ARGS="${PULL_ARGS} --user AWS:$(aws ecr get-login-password)"
elif [[ "${PAUSE_CONTAINER_IMAGE}" == *"public.ecr.aws"* ]]; then
  # ECR public authentication must always be through us-east-1
  # https://docs.aws.amazon.com/AmazonECR/latest/public/public-registry-auth.html
  if ECR_PUBLIC_PASSWORD=$(aws ecr-public get-login-password --region=us-east-1); then
    PULL_ARGS="${PULL_ARGS} --user AWS:${ECR_PUBLIC_PASSWORD}"
  else
    echo "Failed to authenticate to public ECR, retrying with unauthenticated pull" >&2
  fi
fi

sudo ctr image pull ${PULL_ARGS} ${PAUSE_CONTAINER_IMAGE}
sudo ctr image tag ${PAUSE_CONTAINER_IMAGE} ${TAG}
# export the sandbox pause image to a tarball, will be imported before kubelet starts
sudo ctr image export ${EXPORT_PATH} ${TAG}

# cleanup pause image and snapshots
sudo ctr image rm ${PAUSE_CONTAINER_IMAGE} ${TAG}
